{{ define "modules/article/html/create" }}
    {{ template "templates/layouts/html/head" .}}
    {{ template "templates/layouts/html/navbar" .}}
    {{ template "templates/layouts/html/header" .}}

    <!-- 开始表单
    ================================================== -->
    <div class="col-md-12 col-xs-12">
        <form class="article-form-container" action="/articles/store" method="POST">
            <div class="form-group">
                <label class="h4 form-control-label" for="title">标题</label>
                <input type="text" class="form-control" name="title" id="title" placeholder="请输入文章标题" required="" value="{{ range .OLD.title }}{{.}}{{end}}">
                <span class="text-danger">{{ .ERRORS.title }}</span>
            </div>

            <div class="form-group">
                <label class="h4 form-control-label" for="content">内容</label>
                <textarea class="form-control" name="content" id="content" placeholder="请输入文章内容" required="" rows="10">{{ range .OLD.content }}{{.}}{{end}}</textarea>
                <span class="text-danger">{{ .ERRORS.content }}</span>
            </div>

            <div>
                <button type="submit" class="btn btn-primary">保存文章</button>
            </div>
        </form>
    </div>
    <!-- 结束表单
    ================================================== -->

    {{ template "templates/layouts/html/footer" .}}
    {{ template "templates/layouts/html/foot" .}}
{{ end }}