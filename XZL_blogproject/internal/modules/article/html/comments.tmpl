{{ define "modules/article/html/comments" }}


<!-- Begin Comment Section -->


<div class="container">
    <div class="row">
        <div class="col-md-8 col-md-offset-2 col-xs-12">
            <div class="comments-section">
                <h3>{{.title}}</h3>
                <form id="commentForm">
                    <div class="form-group">
                        <input type="text" id="nameInput" placeholder="你的用户名" required>
                    </div>
                    <div class="form-group">
                        <textarea id="commentInput" placeholder="你的评论" required></textarea>
                    </div>
                    <button type="submit" id="submitComment">提交你的评论</button>
                </form>
                <div id="commentsList"></div>
            </div>
        </div>
    </div>
</div>

<style>
    .comments-section {
        margin-top: 30px;
        padding: 20px;
        background-color: #f8f9fa;
        border-radius: 5px;
    }
    .comments-section h3 {
        margin-bottom: 20px;
    }
    #commentForm .form-group {
        margin-bottom: 15px;
    }
    #commentForm input,
    #commentForm textarea {
        width: 100%;
        padding: 10px;
        border: 1px solid #ced4da;
        border-radius: 4px;
    }
    #commentForm textarea {
        height: 100px;
    }
    #submitComment {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 4px;
        cursor: pointer;
    }
    #submitComment:hover {
        background-color: #0056b3;
    }
    .comment {
        background-color: white;
        border: 1px solid #e9ecef;
        border-radius: 4px;
        padding: 15px;
        margin-top: 15px;
        position: relative;
    }
    .comment-author {
        font-weight: bold;
        margin-bottom: 5px;
    }
    .comment-date {
        font-size: 0.8em;
        color: #6c757d;
    }
    .delete-comment {
        position: absolute;
        top: 10px;
        right: 10px;
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 5px 10px;
        border-radius: 4px;
        cursor: pointer;
        display: none;
    }
    .delete-comment:hover {
        background-color: #c82333;
    }
    .comment:hover .delete-comment {
        display: block;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const commentForm = document.getElementById('commentForm');
        const commentsList = document.getElementById('commentsList');

        commentForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const name = document.getElementById('nameInput').value;
            const comment = document.getElementById('commentInput').value;
            
            if (name && comment) {
                addComment(name, comment);
                commentForm.reset();
            }
        });

        function addComment(name, comment) {
            const commentElement = document.createElement('div');
            commentElement.className = 'comment';
            
            const currentDate = new Date().toLocaleString();
            
            commentElement.innerHTML = `
                <div class="comment-author">${escapeHtml(name)}</div>
                <div class="comment-content">${escapeHtml(comment)}</div>
                <div class="comment-date">${currentDate}</div>
                <button class="delete-comment" onclick="deleteComment(this)">删除</button>
            `;
            
            commentsList.prepend(commentElement);
        }

        function escapeHtml(unsafe) {
            return unsafe
                 .replace(/&/g, "&amp;")
                 .replace(/</g, "&lt;")
                 .replace(/>/g, "&gt;")
                 .replace(/"/g, "&quot;")
                 .replace(/'/g, "&#039;");
        }

        window.deleteComment = function(button) {
            if (confirm('确定要删除这条评论吗？')) {
                const commentElement = button.parentElement;
                commentElement.remove();
            }
        };
    });
</script>
<!-- End Comment Section -->
{{ end }}